# ──────────────────────────────────────────────────────────────
# SEO / Verificação de propriedade
# ──────────────────────────────────────────────────────────────
# Google Search Console (apenas o valor do content da meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools (valor da msvalidate.01)
NEXT_PUBLIC_BING_VERIFICATION=

# ──────────────────────────────────────────────────────────────
# Tráfego pago / Analytics (preencha apenas os que for usar)
# Sem valor, a tag NÃO é carregada. Tudo respeita o consentimento (LGPD).
# ──────────────────────────────────────────────────────────────
# Google Tag Manager — ex: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 — ex: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Google Ads (tag global) — ex: AW-XXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Google Ads — rótulo de conversão (usar com o helper de tracking, se aplicável)
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
# Meta (Facebook/Instagram) Pixel — ex: 1234567890
NEXT_PUBLIC_FB_PIXEL_ID=

# ──────────────────────────────────────────────────────────────
# Integrações já existentes no projeto (placeholders)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
AUTOMARTICLES_WEBHOOK_SECRET=
